# Copy to .env.local and fill in values. Never commit real secrets.

# Neon Postgres connection string (Neon dashboard → Connect)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Generate a secret with: pnpm auth:secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of the app (used by Better Auth for callbacks and cookies)
BETTER_AUTH_URL="http://localhost:3000"
